{
  "name": "app",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./components/*.js": "./dist/components/*.js"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=./public/js/index.js --format=esm --target=es2020",
    "dev": "esbuild src/index.ts --bundle --outfile=public/js/index.js --format=esm --target=es2020 --watch",
    "serve": "pnpm build &&  python3 -m http.server 8080"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.8.0",
  "devDependencies": {
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}
