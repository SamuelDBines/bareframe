{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deliveryflow/contracts/define.requirements.v1.0.schema.json",
  "title": "DefineRequirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "project", "summary", "problem", "users", "user_stories"],
  "properties": {
    "contract": { "const": "define.requirements" },
    "version": { "const": "1.0" },
    "project": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["connector"],
        "properties": {
          "connector": { "type": "string" },
          "tool": { "type": ["string", "null"] },
          "ref": { "type": ["string", "null"] }
        }
      }
    },
    "problem": { "type": "string" },
    "users": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["persona", "need"],
        "properties": {
          "persona": { "type": "string" },
          "need": { "type": "string" }
        }
      }
    },
    "user_stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "as_a", "i_want", "so_that", "acceptance_criteria", "priority"],
        "properties": {
          "id": { "type": "string" },
          "as_a": { "type": "string" },
          "i_want": { "type": "string" },
          "so_that": { "type": "string" },
          "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "priority": { "enum": ["must", "should", "could"] }
        }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "success_measures": { "type": "array", "items": { "type": "string" } },
    "out_of_scope": { "type": "array", "items": { "type": "string" } }
  }
}
