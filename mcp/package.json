{
  "name": "@bareframe/mcp-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:data": "node ./scripts/bundle-catalog.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "npm run prepare:data && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "stdio": "node dist/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
