{
  "name": "@bareframe/react",
  "version": "0.1.0",
  "description": "Accessible React components for Bareframe design systems — theme tokens, legacy Repkit (--rk-*) compatibility, and React Aria primitives.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/themes/light.css",
    "./themes/*.css": "./dist/themes/*.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node ./scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build",
    "pack-quality": "node ./scripts/pack-quality.mjs",
    "consumer-smoke": "node ./scripts/consumer-smoke.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.8.2",
    "@react-aria/i18n": "^3.12.10",
    "react-aria-components": "^1.11.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@axe-core/react": "^4.10.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "axe-core": "^4.11.0",
    "jsdom": "^26.1.0",
    "publint": "^0.3.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamuelDBines/bareframe.git",
    "directory": "packages/react"
  },
  "homepage": "https://bareframe.org",
  "bugs": {
    "url": "https://github.com/SamuelDBines/bareframe/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "bareframe",
    "react",
    "components",
    "design-system",
    "accessibility",
    "react-aria",
    "ui",
    "repkit"
  ]
}
