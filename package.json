{
  "description": "Lightweight, dependency-free Web Components for reusable app UI.",
  "devDependencies": {
    "esbuild": "^0.27.3",
    "typescript": "^5.9.2"
  },
  "exports": {
    ".": "./dist/index.js",
    "./bareframe.min.js": "./dist/bareframe.min.js",
    "./components/*.js": "./dist/components/*.js",
    "./manifest.json": "./dist/manifest.json",
    "./min": "./dist/bareframe.min.js",
    "./themes/*.css": "./dist/themes/*.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "web-components",
    "custom-elements",
    "ui",
    "design-system",
    "bareframe"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "name": "bareframe",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "dev": "pnpm",
    "dev:nunchucks": "nunchucks run dev",
    "dev:kitsune": "kitsune serve public --port 6050 --follow",
    "generate:examples": "node ./scripts/generate-examples.mjs",
    "generate:index": "node ./scripts/generate-index.mjs",
    "generate:versions": "node ./scripts/generate-versions.mjs",
    "pack:preview": "npm pack --dry-run",
    "prepack": "npm run build",
    "serve:complex": "cd public \u0026\u0026 ln -sfn ../themes themes \u0026\u0026 ln -sfn ../dist dist \u0026\u0026 python3 -m http.server 8088",
    "serve": "cd public && python3 -m http.server 8088",
    "typecheck": "tsc --noEmit",
    "prepare": "nunchucks precompile -views ./views -out ./public -out-format html --watch",
    "watch": "node --watch --watch-path=src --watch-path=themes --watch-path=scripts --watch-path=tsconfig.json ./scripts/build.mjs"
  },
  "type": "module",
  "version": "0.1.5"
}