{
  "description": "Lightweight, dependency-free Web Components for reusable app UI.",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@stencil/core": "^4.43.4",
    "@types/node": "^25.6.0",
    "esbuild": "^0.27.3",
    "sirv-cli": "^3.0.1",
    "typescript": "^5.9.2"
  },
  "exports": {
    ".": "./dist/index.js",
    "./bareframe.min.js": "./dist/bareframe.min.js",
    "./components/*.js": "./dist/components/*.js",
    "./manifest.json": "./dist/manifest.json",
    "./tokens.json": "./dist/tokens.json",
    "./min": "./dist/bareframe.min.js",
    "./themes/*.css": "./dist/themes/*.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "ui",
    "design-system",
    "bareframe"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "name": "bareframe",
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "build": "node ./scripts/build.mjs && node ./scripts/prep-pages.mjs",
    "build:react": "pnpm --filter @bareframe/react build",
    "build:lib": "node ./scripts/build.mjs",
    "build:pages": "pnpm run build && pnpm run generate:examples && pnpm run generate:versions && pnpm run prep-pages && pnpm --prefix showcase build && pnpm run smoke:pages",
    "dev": "pnpm",
    "dev:kitsune": "kitsune serve public --port 6050 --follow",
    "generate:examples": "node ./scripts/generate-examples.mjs",
    "generate:index": "node ./scripts/generate-index.mjs",
    "generate:versions": "node ./scripts/generate-versions.mjs",
    "prep-pages": "node ./scripts/prep-pages.mjs",
    "pack:preview": "npm pack --dry-run",
    "prepack": "node ./scripts/build.mjs",
    "serve": "cd public && python3 -m http.server 8088",
    "serve:complex": "cd public && ln -sfn ../themes themes && ln -sfn ../dist dist && python3 -m http.server 8088",
    "smoke:pages": "node ./scripts/smoke-pages.mjs",
    "studio": "pnpm run build && pnpm --prefix showcase dev",
    "validate:theme": "node ./scripts/validate-theme.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "showcase:dev": "pnpm --prefix showcase dev",
    "showcase:build": "pnpm run build:pages",
    "prototype:dev": "pnpm --prefix prototype dev",
    "prototype:build": "pnpm run build:react && pnpm --prefix prototype install && pnpm test:react && BAREFRAME_PAGES_ROOT=1 pnpm --prefix prototype run build",
    "test:react": "pnpm --filter @bareframe/react test:coverage",
    "pages:finalize": "node ./scripts/finalize-pages.mjs",
    "typecheck": "tsc --noEmit",
    "watch": "node --watch --watch-path=src --watch-path=themes --watch-path=scripts --watch-path=stencil --watch-path=tsconfig.json ./scripts/build.mjs"
  },
  "type": "module",
  "version": "0.1.6"
}
