{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bareframe.org/contracts/bareframe.package.v1.0.schema.json",
  "title": "BareframePackage",
  "description": "SKETCH. The defined output of Bareframe: one idea in, one reviewable product package out. Embeds a valid Delivery Flow define.requirements v1.0 and design.spec v1.0 so the Plan and Build stages can use it with no LLM work.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract","version","project","summary","status","intake","product","naming","branding","design_options","selected_direction","ia","journeys","prototype","copy","handoff","review","delivery_flow"],
  "properties": {
    "contract": {"const": "bareframe.package"},
    "version": {"const": "1.0"},
    "project": {"type": "string"},
    "summary": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/Source"}},
    "status": {"enum": ["draft","in_review","revision_requested","approved","handed_off"]},
    "revision": {"type": "integer", "minimum": 0, "description": "0 = first delivery; included rounds = 2"},
    "intake": {
      "type": "object", "additionalProperties": false,
      "required": ["idea","audience","answers"],
      "properties": {
        "idea": {"type": "string"},
        "audience": {"type": "string"},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "references": {"type": "array", "items": {"type": "object", "properties": {"url": {"type": "string"}, "note": {"type": "string"}}, "required": ["url"]}},
        "answers": {"type": "array", "items": {"type": "object", "required": ["question_id","answer"], "properties": {"question_id": {"enum": ["q1_problem","q2_audience","q3_first_action","q4_money","q5_feel","q6_must_haves","q7_avoid","q8_existing_assets"]}, "answer": {"type": "string"}, "used_default": {"type": "boolean"}}}},
        "assumptions": {"type": "array", "items": {"type": "object", "required": ["question_id","assumed_answer","reason"], "properties": {"question_id": {"type": "string"}, "assumed_answer": {"type": "string"}, "reason": {"type": "string"}}}}
      }
    },
    "product": {
      "type": "object", "additionalProperties": false,
      "required": ["problem","audience","value_proposition","core_features","mvp_scope","non_goals"],
      "properties": {
        "problem": {"type": "string"},
        "audience": {"type": "array", "items": {"type": "object", "required": ["persona","need"], "properties": {"persona": {"type": "string"}, "need": {"type": "string"}}}, "minItems": 1},
        "value_proposition": {"type": "string"},
        "core_features": {"type": "array", "items": {"type": "object", "required": ["id","name","story_ids"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "story_ids": {"type": "array", "items": {"type": "string"}}}}},
        "mvp_scope": {"type": "array", "items": {"type": "string"}, "description": "feature ids in MVP"},
        "non_goals": {"type": "array", "items": {"type": "string"}},
        "success_measures": {"type": "array", "items": {"type": "string"}}
      }
    },
    "naming": {
      "type": "object", "required": ["options"],
      "properties": {
        "options": {"type": "array", "minItems": 5, "maxItems": 7, "items": {
          "type": "object", "required": ["name","rationale","domains","trademark","verified_by_human"],
          "properties": {
            "name": {"type": "string"}, "rationale": {"type": "string"},
            "domains": {"type": "array", "items": {"type": "object", "properties": {"domain": {"type": "string"}, "apparent_status": {"enum": ["looks_free","taken","for_sale","unknown"]}}}},
            "trademark": {"type": "object", "properties": {"registers_checked": {"type": "array", "items": {"enum": ["UKIPO","EUIPO","USPTO"]}}, "classes": {"type": "array", "items": {"type": "integer"}}, "notes": {"type": "string"}}},
            "verified_by_human": {"const": false, "description": "Always false from the generator; a human must verify domain and trademark"}
          }}},
        "recommended": {"type": "string"}
      }
    },
    "branding": {
      "type": "object", "required": ["personality","tone_of_voice","taglines","logo_direction"],
      "properties": {
        "personality": {"type": "array", "items": {"type": "string"}, "minItems": 3, "maxItems": 5},
        "tone_of_voice": {"type": "object", "properties": {"we_are": {"type": "array", "items": {"type": "string"}}, "we_are_not": {"type": "array", "items": {"type": "string"}}, "examples": {"type": "array", "items": {"type": "object", "properties": {"do": {"type": "string"}, "dont": {"type": "string"}}}}}},
        "taglines": {"type": "array", "items": {"type": "string"}, "minItems": 3},
        "logo_direction": {"type": "object", "properties": {"concept": {"type": "string"}, "type": {"enum": ["wordmark","lettermark","symbol_plus_wordmark","emblem"]}, "do": {"type": "array", "items": {"type": "string"}}, "avoid": {"type": "array", "items": {"type": "string"}}, "concept_image_refs": {"type": "array", "items": {"type": "string"}}}}
      }
    },
    "design_options": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "#/$defs/DesignDirection"}},
    "selected_direction": {"type": ["string","null"], "description": "DesignDirection.id chosen by customer; null until chosen"},
    "ia": {
      "type": "object", "required": ["sitemap"],
      "properties": {"sitemap": {"type": "array", "items": {"$ref": "#/$defs/SitemapNode"}}, "navigation": {"type": "object", "properties": {"primary": {"type": "array", "items": {"type": "string"}}, "footer": {"type": "array", "items": {"type": "string"}}}}}
    },
    "journeys": {"type": "array", "minItems": 3, "maxItems": 5, "items": {
      "type": "object", "required": ["id","name","persona","goal","story_ids","steps"],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"}, "persona": {"type": "string"}, "goal": {"type": "string"},
        "story_ids": {"type": "array", "items": {"type": "string"}},
        "steps": {"type": "array", "items": {"type": "object", "required": ["screen_id","action"], "properties": {"screen_id": {"type": "string"}, "action": {"type": "string"}, "target": {"type": "string", "description": "component node id of the hotspot"}, "next_screen_id": {"type": ["string","null"]}}}},
        "flow_map_ref": {"type": "string", "description": "Bareframe Designer flow id / canvas URL"}
      }}},
    "prototype": {
      "type": "object", "required": ["designer_project_id","share_url","screens"],
      "properties": {
        "designer_project_id": {"type": "string"}, "share_url": {"type": "string"},
        "library": {"const": "@bareframe/react"}, "library_version": {"type": "string"},
        "screens": {"type": "array", "minItems": 6, "maxItems": 12, "items": {"type": "object", "required": ["id","name","route","components"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "route": {"type": "string"}, "components": {"type": "array", "items": {"type": "string"}}, "story_ids": {"type": "array", "items": {"type": "string"}}, "screenshot_ref": {"type": "string"}}}}
      }
    },
    "copy": {"type": "array", "items": {"type": "object", "required": ["screen_id","blocks"], "properties": {"screen_id": {"type": "string"}, "blocks": {"type": "array", "items": {"type": "object", "required": ["key","text"], "properties": {"key": {"type": "string", "description": "e.g. hero.heading, cta.primary, error.empty"}, "text": {"type": "string"}}}}}}},
    "handoff": {
      "type": "object", "required": ["components","design_tokens","scaffolded_screens","stack"],
      "properties": {
        "components": {"type": "array", "items": {"type": "object", "properties": {"slug": {"type": "string"}, "stability": {"enum": ["stable","experimental"]}, "used_on": {"type": "array", "items": {"type": "string"}}}}},
        "design_tokens": {"type": "object", "description": "export_tokens output for selected direction: color, space, radius, typography, shadow"},
        "scaffolded_screens": {"type": "array", "items": {"type": "object", "properties": {"screen_id": {"type": "string"}, "path": {"type": "string"}, "tsx": {"type": "string"}}}},
        "data_entities": {"type": "array", "items": {"type": "string"}},
        "api_contracts": {"type": "array", "items": {"type": "object"}},
        "stack": {"type": "object", "properties": {"frontend": {"const": "React + @bareframe/react"}, "backend": {"enum": ["Go","FastAPI"]}, "hosting": {"const": "kuboh.dev"}, "email": {"const": "RelayEmail"}, "analytics": {"const": "Telemetry"}, "database": {"type": "string"}}}
      }
    },
    "review": {
      "type": "object", "required": ["checklist","rounds_included","rounds_used"],
      "properties": {
        "checklist": {"type": "array", "items": {"type": "object", "required": ["id","item","status"], "properties": {"id": {"type": "string"}, "section": {"type": "string"}, "item": {"type": "string"}, "status": {"enum": ["pending","approved","change_requested"]}, "comment": {"type": "string"}}}},
        "rounds_included": {"const": 2}, "rounds_used": {"type": "integer"},
        "approved_by": {"type": ["string","null"]}, "approved_at": {"type": ["string","null"], "format": "date-time"}
      }
    },
    "handoff_path": {"enum": ["export","share_link","delivery_flow"]},
    "delivery_flow": {
      "type": "object", "additionalProperties": false, "required": ["define","design"],
      "description": "Embedded, independently valid Delivery Flow contracts generated from the sections above",
      "properties": {
        "define": {"type": "object"},
        "design": {"type": "object"}
      }
    }
  },
  "$defs": {
    "Source": {"type": "object", "required": ["connector"], "properties": {"connector": {"type": "string"}, "tool": {"type": ["string","null"]}, "ref": {"type": ["string","null"]}}},
    "DesignDirection": {
      "type": "object", "required": ["id","name","mood","palette","typography","bareframe_theme"],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"}, "mood": {"type": "string"},
        "palette": {"type": "object", "required": ["primary","secondary","neutral","surface","text","success","warning","danger"], "additionalProperties": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}},
        "contrast_checks": {"type": "array", "items": {"type": "object", "properties": {"pair": {"type": "string"}, "ratio": {"type": "number"}, "wcag_aa": {"type": "boolean"}}}},
        "typography": {"type": "object", "properties": {"heading_font": {"type": "string"}, "body_font": {"type": "string"}, "scale": {"type": "array", "items": {"type": "number"}}, "licence": {"type": "string"}}},
        "radius": {"type": "string"}, "density": {"enum": ["compact","comfortable","spacious"]},
        "bareframe_theme": {"type": "object", "required": ["base_theme"], "properties": {"base_theme": {"type": "string", "description": "a list_themes id, e.g. aurora"}, "overrides": {"type": "object"}}},
        "preview_screen_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "SitemapNode": {"type": "object", "required": ["id","title","route"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "route": {"type": "string"}, "auth": {"enum": ["public","signed_in","admin"]}, "mvp": {"type": "boolean"}, "children": {"type": "array", "items": {"$ref": "#/$defs/SitemapNode"}}}}
  }
}
